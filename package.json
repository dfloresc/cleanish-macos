{
  "name": "cleanish",
  "version": "1.0.0",
  "private": true,
  "description": "Cleanish — macOS cleaner and disk usage inspector",
  "main": "./out/main/index.js",
  "license": "MIT",
  "author": {
    "name": "Daniel Flores Castillo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dfloresc/cleanish-macos.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "postinstall": "node -e \"require('electron')\"",
    "dev": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "npm run typecheck && electron-vite build && electron-builder --mac",
    "generate-icon": "electron scripts/render-icon.cjs",
    "test": "node tests/run.mjs"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/plist": "^3.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.29.0",
    "plist": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "overrides": {
    "@xmldom/xmldom@<0.9.0": "0.8.15",
    "@xmldom/xmldom@>=0.9.0 <0.9.12": "0.9.12",
    "fast-uri": "3.1.7",
    "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
    "nanoid@>=3.0.0 <3.3.18": "3.3.19"
  }
}
